{
  // Nama harus sama persis dengan nama Worker di dashboard Cloudflare.
  "name": "titip-jajan-1",
  "main": "worker.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  }
}
